						</ul>
						<div class="col-lg-6 col-xs-12 forced-pull-right-search">
							<form action="" method="get" id="history-search">
								<div class="input-group">
									<input name="search" class="form-control" placeholder="Search orders" type="text" />
									<span class="input-group-btn">
									<button type="submit" class="btn btn-default"><i class="fa fa-search" aria-hidden="true"></i></button>
									</span>
								</div>
							</form>
						</div>
						
						<select class="custom-select w-full" >
							<option value="[subscription.tab.all.url-query]" [subscription.tab.all.select_class] >[subscription.tab.all]</a></option>
							<option value="[subscription.tab.Active.url-query]" [subscription.tab.Active.select_class] >[subscription.tab.Active]</a></option>
							<option value="[subscription.tab.Paused.url-query]" [subscription.tab.Paused.select_class] >[subscription.tab.Paused]</a></option>
							<option value="[subscription.tab.Completed.url-query]" [subscription.tab.Completed.select_class] >[subscription.tab.Completed]</a></option>
							<option value="[subscription.tab.Partial.url-query]" [subscription.tab.Partial.select_class] >[subscription.tab.Partial]</a></option>
