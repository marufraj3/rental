		<div class="paddingbody"></div>
		<div class="">			
			<div class="container-fluid container-fluid-spacious">
				<div class="row">
					<div class="col-md-12">
						<div id="main-page" class="well well-float table-responsive">
							<div class="">
								[error_message]
								
								
								<form method="post" action="">
									<div class="form-group">
										<label class="control-label" for="current_password">[settings.form.current_password]</label>
										<input name="current_password" class="form-control" id="current_password" value="" type="password">
										<p class="help-block help-block-error"></p>
									</div>

									<div class="form-group">
										<label class="control-label" for="new_password">[settings.form.new_password]</label>
										<input name="new_password" class="form-control" id="new_password" type="password">
										<p class="help-block help-block-error"></p>
									</div>

									<div class="form-group">
										<label class="control-label" for="new_password2">[settings.form.retype_password]</label>
										<input name="new_password2" class="form-control" id="new_password2" type="password">
										<p class="help-block help-block-error"></p>
									</div>
									<input type="hidden" name="password_reset" value="password_reset" >
									<button type="submit" class="btn btn-default m-b">[settings.form.submit_pass_button]</button>
									[panel.csrf_protection]
								</form>
								
								<form action="" method="POST">
									<div class="form-group panel-border-top">
										<label class="control-label" for="default_time_zone">[settings.form.timezone]</label>
										<select  name="default_time_zone" id="default_time_zone"  class="form-control" >
											[settings.form.timezone_list]	
										</select>
									</div>
									
									<input type="hidden" name="change_default_time_zone" value="change_default_time_zone" >
									<button type="submit" class="btn btn-default">[settings.form.timezone_button]</button>
									[panel.csrf_protection]
								</form>
								
								<form action="" method="POST">
									<div class="form-group panel-border-top">
										<label class="control-label" for="api_key">[settings.form.api_key_text]</label>
										<input class="form-control" id="api_key" value="[user.api_key]" readonly="readonly" type="text">
									</div>
									
									<input type="hidden" name="api_reset" value="api_reset" >
									<button type="submit" class="btn btn-default">[settings.form.api_key_button]</button>
									[panel.csrf_protection]
								</form>
								
							</div>
						</div>
						
					</div>
				</div>
			</div>
		</div>
		