<style id="rental-resetpassword-clone">
/* ═══ TOKENS · LIGHT (base) ═══ */
#rzPage{
 --red:#D40C1C;--red2:#F0303A;--redD:#96060F;
 --grd:linear-gradient(135deg,#96060F,#D40C1C 52%,#F0303A);
 --soft:rgba(212,12,28,.08);--soft2:rgba(212,12,28,.14);
 --card:rgba(255,255,255,.90);--card2:rgba(250,251,253,.90);--fld:rgba(245,246,249,.95);
 --line:rgba(12,12,20,.10);--line2:rgba(212,12,28,.26);
 --tx:#0B0B12;--tx2:#4C4C5A;--mut:#8A8A98;
 --glow:radial-gradient(closest-side,rgba(212,12,28,.12),transparent);
 --dngBg:rgba(239,68,68,.14);--dngTx:#DC2626;--dngLn:rgba(239,68,68,.32);
 --sucBg:rgba(34,197,94,.14);--sucTx:#15803D;--sucLn:rgba(34,197,94,.32);
 font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--tx);background:transparent;
 position:relative;z-index:1;overflow-x:clip;display:block;-webkit-font-smoothing:antialiased}

/* ═══ TOKENS · DARK ═══ */
html.dark #rzPage,body.dark #rzPage,
html.dark-mode #rzPage,body.dark-mode #rzPage,
html.nightmode #rzPage,body.nightmode #rzPage,
html[data-bs-theme=dark] #rzPage,body[data-bs-theme=dark] #rzPage,
html[data-theme=dark] #rzPage,body[data-theme=dark] #rzPage,
html[data-rzdm="1"] #rzPage{
 --red:#E11020;--red2:#FF3B42;--redD:#A50C16;
 --grd:linear-gradient(135deg,#A50C16,#E11020 52%,#FF3B42);
 --soft:rgba(225,16,32,.10);--soft2:rgba(225,16,32,.18);
 --card:rgba(15,15,20,.86);--card2:rgba(20,20,25,.86);--fld:rgba(8,8,12,.90);
 --line:rgba(255,255,255,.10);--line2:rgba(225,16,32,.34);
 --tx:#FFFFFF;--tx2:#B4B4BF;--mut:#7A7A87;
 --glow:radial-gradient(closest-side,rgba(225,16,32,.24),transparent);
 --dngTx:#F87171;--sucTx:#4ADE80}

/* browser canvas + scrollbars follow the theme → no white flash on load */
html[data-rzdm="0"]{color-scheme:light}
html[data-rzdm="1"]{color-scheme:dark}

/* freeze every transition for one frame while the theme swaps */
html.rz-swap #rzPage *,html.rz-swap #rzPage *::before,html.rz-swap #rzPage *::after{transition:none!important}
html.rz-swap .rzbg *{transition:none!important}

/* ═══ SHELL TINT (header / footer) ═══ */
body#guest.wr-dark,body#outside.wr-dark,body.wr-dark{
 --mc:#E11020;--mc-hover:#FF3B42;--mc-trans:rgba(225,16,32,.12);
 --main-bg:#050507;--second-bg:#0A0A0E;--card-bg:#0F0F14;--title-bg:#0C0C11;
 --border:rgba(255,255,255,.08);--tc:#FFFFFF;--ts:#C2C2CE;--tw:#8E8E9C;
 --sky-grad:linear-gradient(135deg,#A50C16,#E11020 52%,#FF3B42);
 --sky-soft:rgba(225,16,32,.12);--sky-shadow:none;
 --og-grad:linear-gradient(135deg,#A50C16,#E11020 52%,#FF3B42);
 --og-soft:rgba(225,16,32,.12);--og-line:rgba(225,16,32,.28);
 --og-glass:rgba(15,15,20,.72);--og-shadow:none}
body#guest.wr-light,body#outside.wr-light,body.wr-light{
 --mc:#D40C1C;--mc-hover:#F0303A;--mc-trans:rgba(212,12,28,.09);
 --main-bg:#F4F5F8;--second-bg:#FFFFFF;--card-bg:#FFFFFF;--title-bg:#F8F9FB;
 --border:rgba(12,12,20,.09);--tc:#0B0B12;--ts:#3E3E4B;--tw:#6E6E7C;
 --sky-grad:linear-gradient(135deg,#96060F,#D40C1C 52%,#F0303A);
 --sky-soft:rgba(212,12,28,.08);--sky-shadow:none;
 --og-grad:linear-gradient(135deg,#96060F,#D40C1C 52%,#F0303A);
 --og-soft:rgba(212,12,28,.08);--og-line:rgba(212,12,28,.22);
 --og-glass:rgba(255,255,255,.76);--og-shadow:none}

/* page background — delete these 2 rules to keep the layout's own background */
html,body{background:radial-gradient(105% 78% at 50% -14%,#FFE0E3,transparent 62%),#F6F7FA!important;background-attachment:fixed!important}
html.dark,body.dark,html.dark body,
html.nightmode,body.nightmode,html.nightmode body,
html[data-bs-theme=dark],html[data-bs-theme=dark] body,
html[data-theme=dark],html[data-theme=dark] body,
html[data-rzdm="1"],html[data-rzdm="1"] body{
 background:radial-gradient(105% 78% at 50% -14%,#2A0509,transparent 62%),#050507!important;background-attachment:fixed!important}

/* the dashboard's outer scroll wrapper paints its own solid background-color,
   which sits in front of the fixed layer. Transparent in both themes, or the
   photo disappears behind a flat panel. */
html[data-rzdm="1"] .app-content,
html[data-rzdm="1"] .app-content::before,
html[data-rzdm="1"] .app-content::after,
html[data-rzdm="0"] .app-content,
html[data-rzdm="0"] .app-content::before,
html[data-rzdm="0"] .app-content::after{background-color:transparent!important;background:transparent!important}

/* ═══════════════════════════════════════════════════════════
   FULL-SCREEN PHOTO BACKGROUND
   fixed to the viewport and moved out to <body> by the script at the
   bottom, so no ancestor can clip it or cut it short.
   ═══════════════════════════════════════════════════════════ */
.rzbg{position:fixed;top:0;left:0;right:0;bottom:0;z-index:0;pointer-events:none;overflow:hidden;
 --red2:#F0303A;--tx:#0B0B12;
 --scrim:linear-gradient(180deg,rgba(246,247,250,.94) 0%,rgba(246,247,250,.80) 34%,rgba(246,247,250,.90) 72%,rgba(246,247,250,.99) 100%),
   radial-gradient(90% 62% at 50% 12%,rgba(212,12,28,.14),transparent 68%);
 --sweep:linear-gradient(90deg,transparent,rgba(212,12,28,.05) 50%,transparent)}
html[data-rzdm="1"] .rzbg{
 --red2:#FF3B42;--tx:#FFFFFF;
 --scrim:linear-gradient(180deg,rgba(4,4,6,.90) 0%,rgba(4,4,6,.72) 34%,rgba(4,4,6,.86) 72%,rgba(4,4,6,.97) 100%),
   radial-gradient(90% 62% at 50% 12%,rgba(225,16,32,.26),transparent 68%),
   radial-gradient(60% 50% at 8% 90%,rgba(160,8,20,.22),transparent 70%)}

.rzbg .photo{position:absolute;inset:-2%;
 background-image:url("https://storage.perfectcdn.com/eq86bz/6ozg3idaenquaawl.jfif");
 background-position:center center;background-size:cover;background-repeat:no-repeat;
 transform:scale(1.03);filter:saturate(1.06) contrast(1.02);
 animation:rzPan 32s ease-in-out infinite alternate}
@keyframes rzPan{0%{transform:scale(1.03) translate3d(0,0,0)}100%{transform:scale(1.09) translate3d(-1.4%,-1%,0)}}
.rzbg .scrim{position:absolute;inset:0;background:var(--scrim)}
.rzbg .spot{position:absolute;width:74%;height:150%;left:-24%;top:-46%;transform:rotate(24deg);
 background:var(--sweep);filter:blur(2px);animation:rzSpot 18s ease-in-out infinite alternate}
html[data-rzdm="1"] .rzbg .spot{
 background:linear-gradient(90deg,transparent,rgba(255,255,255,.06) 42%,rgba(255,255,255,.10) 50%,rgba(255,255,255,.06) 58%,transparent)}
@keyframes rzSpot{0%{transform:rotate(24deg) translateX(-6%)}100%{transform:rotate(24deg) translateX(16%)}}
.rzbg .emb{position:absolute;width:4px;height:4px;border-radius:50%;background:var(--red2);filter:blur(1px);opacity:0;animation:rzRise 12s linear infinite}
@keyframes rzRise{0%{transform:translateY(0) scale(1);opacity:0}12%{opacity:.8}70%{opacity:.32}100%{transform:translateY(-340px) scale(.35);opacity:0}}
.rzbg .spk{position:absolute;width:18px;height:18px;animation:rzTw 4.6s ease-in-out infinite}
.rzbg .spk svg{width:100%;height:100%;display:block}
.rzbg .spk-a path{fill:var(--red2)}
.rzbg .spk-b path{fill:var(--tx);opacity:.72}
@keyframes rzTw{0%,100%{opacity:.14;transform:scale(.7) rotate(0)}50%{opacity:.92;transform:scale(1.1) rotate(35deg)}}
@media(prefers-reduced-motion:reduce){ .rzbg *{animation:none!important}}

#rzPage *{box-sizing:border-box}
#rzPage .wrp{max-width:1180px;margin:0 auto;padding:0 22px;position:relative;z-index:3}
#rzPage .rv{opacity:0;transform:translateY(24px);transition:opacity .75s cubic-bezier(.22,1,.36,1),transform .75s cubic-bezier(.22,1,.36,1)}
#rzPage .rv.on{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){ #rzPage .rv{opacity:1;transform:none;transition:none}
 #rzPage *{animation:none!important}}

/* ═══ STAGE ═══ */
#rzPage .stage{position:relative;padding:210px 0 76px}

/* ═══ GRID ═══ */
#rzPage .grid{display:grid;grid-template-columns:1.02fr .98fr;gap:20px;align-items:stretch;position:relative;z-index:3}

#rzPage .card{position:relative;display:flex;flex-direction:column;
 background:linear-gradient(168deg,var(--card),var(--card2));
 border:1px solid var(--line);border-radius:22px;padding:30px 30px 26px;overflow:hidden;
 backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);transform:translateZ(0)}
#rzPage .card::after{content:"";position:absolute;top:-120px;right:-100px;width:260px;height:260px;border-radius:50%;
 background:var(--glow);filter:blur(34px);pointer-events:none;z-index:0}
#rzPage .card>*{position:relative;z-index:1}

/* card header */
#rzPage .ch{display:flex;flex-wrap:wrap;align-items:center;gap:13px;margin-bottom:22px;padding-bottom:20px;border-bottom:1px dashed var(--line)}
#rzPage .ch .ch-top{display:flex;align-items:center;gap:13px;flex:1 1 auto;min-width:0}
#rzPage .ch em{width:46px;height:46px;min-width:46px;border-radius:14px;background:var(--grd);color:#fff;font-style:normal;
 display:inline-flex;align-items:center;justify-content:center;font-size:18px}
#rzPage .ch h1,#rzPage .ch h2{font-size:20px;font-weight:800;margin:0;color:var(--tx);letter-spacing:-.024em;line-height:1.25}
#rzPage .ch h1 span{color:var(--red)}
#rzPage .ch small{display:block;width:100%;color:var(--mut);font-size:12px;font-weight:600;margin-top:4px;line-height:1.6}
#rzPage .ch .pill{margin-left:auto;display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 11px;border-radius:7px;
 background:var(--soft);border:1px solid var(--line2);color:var(--red);font-size:10px;font-weight:800;letter-spacing:.1em;white-space:nowrap}

/* alerts */
#rzPage .alert{border-radius:11px!important;font-size:13px;font-weight:700;padding:12px 40px 12px 15px;margin-bottom:14px;
 border:1px solid transparent;position:relative}
#rzPage .alert-danger{background:var(--dngBg)!important;color:var(--dngTx)!important;border-color:var(--dngLn)!important}
#rzPage .alert-success{background:var(--sucBg)!important;color:var(--sucTx)!important;border-color:var(--sucLn)!important}
#rzPage .alert .close{position:absolute;right:10px;top:8px;background:transparent;border:0;color:inherit;opacity:.7;
 font-size:19px;line-height:1;cursor:pointer;padding:2px 6px}

/* form */
#rzPage .form-group{position:relative;margin-bottom:16px}
#rzPage .control-label{display:block;font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
 color:var(--mut);margin-bottom:8px}
#rzPage .rz-fic{position:absolute;left:15px;bottom:18px;color:var(--red);font-size:13px;z-index:2;pointer-events:none}
#rzPage .form-control{display:block;width:100%;height:52px;line-height:52px;background:var(--fld);
 border:1.5px solid var(--line);color:var(--tx);border-radius:12px;padding:0 16px 0 42px;
 font-size:14px;font-weight:600;font-family:inherit;outline:0;transition:border-color .18s,box-shadow .18s}
#rzPage .form-control::placeholder{color:var(--mut);font-weight:500}
#rzPage .form-control:focus{border-color:var(--red);box-shadow:0 0 0 4px var(--soft)!important}
#rzPage .btn-primary{display:flex!important;align-items:center;justify-content:center;gap:9px;width:100%;height:54px;
 border:0!important;border-radius:13px!important;background:var(--grd)!important;color:#fff!important;
 font-weight:800!important;font-size:15px!important;font-family:inherit!important;cursor:pointer;
 position:relative;overflow:hidden;transition:transform .18s,filter .18s}
#rzPage .btn-primary::after{content:"";position:absolute;top:0;left:-90%;width:42%;height:100%;
 background:linear-gradient(100deg,transparent,rgba(255,255,255,.42),transparent);transform:skewX(-20deg);animation:rzSh 3.6s ease-in-out infinite}
@keyframes rzSh{0%,64%{left:-90%}100%{left:140%}}
#rzPage .btn-primary:hover{transform:translateY(-2px);filter:brightness(1.08)}
#rzPage .back{display:block;text-align:center;margin:16px 0 0;color:var(--tx2);font-size:13px;font-weight:600}
#rzPage .back a{color:var(--red);font-weight:800;text-decoration:none}

/* ── gap filler inside the left card ── */
#rzPage .fill{margin-top:auto;padding-top:22px}
#rzPage .fill-h{display:flex;align-items:center;gap:10px;margin:0 0 12px;font-size:12px;font-weight:800;
 letter-spacing:.1em;text-transform:uppercase;color:var(--mut)}
#rzPage .fill-h::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--grd);box-shadow:0 0 0 4px var(--soft)}
#rzPage .fill-h::after{content:"";flex:1;height:1px;background:var(--line)}
#rzPage .alt{display:flex;flex-direction:column;gap:9px}
#rzPage .alt a{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:13px;text-decoration:none;
 background:var(--fld);border:1px solid var(--line);transition:border-color .2s,transform .2s}
#rzPage .alt a:hover{border-color:var(--line2);transform:translateX(3px)}
#rzPage .alt a em{width:34px;height:34px;min-width:34px;border-radius:11px;background:var(--soft);border:1px solid var(--line2);
 color:var(--red);display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-style:normal;
 transition:background .2s,border-color .2s,color .2s}
#rzPage .alt a:hover em{background:var(--grd);border-color:transparent;color:#fff}
#rzPage .alt a b{display:block;font-size:13px;font-weight:800;color:var(--tx)}
#rzPage .alt a small{display:block;color:var(--mut);font-size:11.5px;font-weight:600;margin-top:2px}
#rzPage .alt a i.go{margin-left:auto;color:var(--mut);font-size:12px;transition:color .2s}
#rzPage .alt a:hover i.go{color:var(--red)}
#rzPage .badges{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:18px;padding-top:18px;border-top:1px solid var(--line)}
#rzPage .badges>div{text-align:center}
#rzPage .badges i{color:var(--red);font-size:13px}
#rzPage .badges b{display:block;font-size:11px;font-weight:800;margin-top:6px;color:var(--tx)}
#rzPage .badges small{display:block;color:var(--mut);font-size:9.5px;font-weight:600}

/* ── right card ── */
#rzPage .side>p{color:var(--tx2);font-size:13px;line-height:1.8;margin:0 0 22px}
#rzPage .tl{position:relative;list-style:none;margin:0;padding:0 0 0 42px}
#rzPage .tl::before{content:"";position:absolute;left:15px;top:10px;bottom:10px;width:1.5px;
 background:linear-gradient(180deg,transparent,var(--line2),var(--line2),transparent)}
#rzPage .tl li{position:relative;padding-bottom:22px}
#rzPage .tl li:last-child{padding-bottom:0}
#rzPage .tl li em{position:absolute;left:-42px;top:0;width:32px;height:32px;border-radius:11px;font-style:normal;
 background:var(--soft);border:1px solid var(--line2);color:var(--red);
 display:inline-flex;align-items:center;justify-content:center;font-size:12px;z-index:1}
#rzPage .tl li b{display:block;font-size:13.5px;font-weight:800;color:var(--tx);margin-bottom:5px}
#rzPage .tl li p{color:var(--tx2);font-size:12.5px;line-height:1.75;margin:0}
#rzPage .note{display:flex;align-items:flex-start;gap:11px;margin-top:22px;padding:14px 15px;border-radius:13px;
 background:var(--soft);border:1px solid var(--line2)}
#rzPage .note i{color:var(--red);font-size:14px;margin-top:2px}
#rzPage .note div{font-size:12.5px;line-height:1.7;color:var(--tx2)}
#rzPage .note b{color:var(--tx);font-weight:800}
#rzPage .help{display:flex;align-items:center;justify-content:center;gap:9px;height:48px;border-radius:12px;
 background:var(--fld);border:1px solid var(--line);color:var(--tx)!important;
 font-size:13px;font-weight:800;text-decoration:none;transition:border-color .2s,color .2s,transform .2s}
#rzPage .help:hover{border-color:var(--line2);color:var(--red)!important;transform:translateY(-2px)}
#rzPage .side .help{margin-top:auto}
#rzPage .side .note{margin-bottom:22px}

/* ═══ RECOVERY Q&A ═══ */
#rzPage .qa{position:relative;padding:0 0 84px}
#rzPage .qa-h{text-align:center;margin:0 0 26px}
#rzPage .qa-h span{display:inline-flex;align-items:center;gap:8px;height:30px;padding:0 14px;border-radius:8px;
 background:var(--soft);border:1px solid var(--line2);color:var(--red);
 font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
#rzPage .qa-h h2{font-size:clamp(21px,2.6vw,30px);font-weight:800;letter-spacing:-.026em;margin:14px 0 0;color:var(--tx)}
#rzPage .qa-h h2 em{font-style:normal;color:var(--red)}
#rzPage .qa-g{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
#rzPage .qa-c{position:relative;padding:22px;border-radius:18px;overflow:hidden;
 background:linear-gradient(170deg,var(--card),var(--card2));border:1px solid var(--line);
 backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);transform:translateZ(0);
 transition:border-color .26s,transform .26s}
#rzPage .qa-c:hover{transform:translateY(-6px);border-color:var(--line2)}
#rzPage .qa-c .qa-head{display:flex;align-items:center;gap:12px;margin-bottom:10px}
#rzPage .qa-c em{width:40px;height:40px;min-width:40px;border-radius:12px;background:var(--soft);border:1px solid var(--line2);
 color:var(--red);display:inline-flex;align-items:center;justify-content:center;font-size:15px;font-style:normal;
 transition:background .26s,border-color .26s,color .26s}
#rzPage .qa-c:hover em{background:var(--grd);border-color:transparent;color:#fff}
#rzPage .qa-c b{font-size:14.5px;font-weight:800;color:var(--tx);line-height:1.4}
#rzPage .qa-c p{color:var(--tx2);font-size:12.5px;line-height:1.8;margin:0}


/* ═══ RESPONSIVE ═══ */
@media(max-width:980px){
 #rzPage .stage{padding:160px 0 60px}
 #rzPage .grid{grid-template-columns:1fr}
 #rzPage .fill{margin-top:24px}
 #rzPage .side .help{margin-top:22px}
 #rzPage .qa-g{grid-template-columns:1fr}
 #rzPage .qa{padding-bottom:64px}
}
@media(max-width:680px){
 html,body{background-attachment:scroll!important}
 #rzPage .stage{padding:130px 0 46px}
 #rzPage .wrp{padding:0 15px}
 #rzPage .card{padding:24px 20px;border-radius:18px}
 .rzbg .photo{animation:none}
 #rzPage .ch{gap:11px}
 #rzPage .ch .pill{display:none}
 #rzPage .badges{grid-template-columns:repeat(3,1fr);gap:6px}
 #rzPage .badges>div{display:flex;flex-direction:column;align-items:center;gap:3px;text-align:center}
 #rzPage .badges b{margin-top:2px;font-size:10.5px;line-height:1.25}
 #rzPage .badges small{font-size:9px;line-height:1.2}
 #rzPage .qa-c{padding:18px}
 #rzPage .qa{padding-bottom:76px}
}
@media(max-width:360px){
 #rzPage .badges b{font-size:9.5px}
 #rzPage .badges small{font-size:8.5px}
}

/* Rental form compatibility — preserves native backend messages and captcha. */
#rzPage .rz-alerts:empty{display:none}
#rzPage .help-block{margin:6px 0 0;color:var(--dngTx);font-size:11px;line-height:1.45}
#rzPage .help-block:empty{display:none}
#rzPage .g-recaptcha{max-width:100%;margin:0 0 16px;overflow:hidden;border-radius:12px}
#rzPage .g-recaptcha>div{max-width:100%}
#rzPage .btn-primary.btn-default{padding:0 20px;line-height:54px;box-shadow:none}
#rzPage .btn-primary.btn-default:focus{background:var(--grd)!important;color:#fff!important}
#rzPage .back .btn{min-height:0;margin:0 0 0 4px;padding:0;border:0;background:transparent;color:var(--red);font-size:13px;font-weight:800;line-height:inherit;box-shadow:none}
#rzPage .back .btn:hover,#rzPage .back .btn:focus{background:transparent;color:var(--red2)}
#rzPage .form-control:-webkit-autofill,#rzPage .form-control:-webkit-autofill:hover,#rzPage .form-control:-webkit-autofill:focus{-webkit-text-fill-color:var(--tx);-webkit-box-shadow:0 0 0 1000px var(--fld) inset!important;transition:background-color 9999s ease-out}
#rzPage .rz-alerts .alert:last-child{margin-bottom:14px}

</style>


<div class="rzbg" id="rzBgFull" aria-hidden="true">
	<span class="photo"></span>
	<span class="scrim"></span>
	<span class="spot"></span>
	<span class="emb" style="left:16%;bottom:12%;animation-delay:0s"></span>
	<span class="emb" style="left:47%;bottom:7%;animation-delay:3.4s"></span>
	<span class="emb" style="left:79%;bottom:16%;animation-delay:6.4s"></span>
	<span class="spk spk-a" style="left:10%;top:24%"><svg viewBox="0 0 24 24"><path d="M12 0c1.2 7 4.8 10.8 12 12-7.2 1.2-10.8 4.8-12 12-1.2-7.2-4.8-10.8-12-12C7.2 10.8 10.8 7 12 0Z"></path></svg></span>
	<span class="spk spk-b" style="right:11%;top:18%;animation-delay:2.2s"><svg viewBox="0 0 24 24"><path d="M12 0c1.2 7 4.8 10.8 12 12-7.2 1.2-10.8 4.8-12 12-1.2-7.2-4.8-10.8-12-12C7.2 10.8 10.8 7 12 0Z"></path></svg></span>
</div>

<main class="wr" id="rzPage">
	<section class="stage" aria-labelledby="reset-page-title">
		<div class="wrp">
			<div class="grid">
				<div class="card rv">
					<div class="ch">
						<div class="ch-top">
							<em><i class="fas fa-key" aria-hidden="true"></i></em>
							<h1 id="reset-page-title">Lost Your <span>Password?</span></h1>
						</div>
						<span class="pill"><i class="fas fa-lock" aria-hidden="true"></i> SECURE</span>
						<small>Enter the email connected to your account and we will send the available recovery instructions.</small>
					</div>

					<div class="rz-alerts">[error_message]</div>

					<form id="yw0" method="post" action="">
						<div class="form-group">
							<label for="email" class="control-label">[reset_email]</label>
							<i class="far fa-envelope rz-fic" aria-hidden="true"></i>
							<input type="text" class="form-control" id="email" name="email" required placeholder="[reset_email]" autocomplete="email" inputmode="email">
							<p class="help-block help-block-error"></p>
						</div>

						[panel.csrf_protection]
						<div class="g-recaptcha form-group" data-sitekey="[panel.google-sitekey]"></div>
						<input type="hidden" name="reset_password_post" value="Reset">

						<button type="submit" class="btn btn-default btn-primary">
							<span>[reset_email_button]</span>
							<i class="fas fa-paper-plane" aria-hidden="true"></i>
						</button>
					</form>

					<p class="back">
						<span>[reset_do_you_text]</span>
						<a href="/index" class="btn btn-default">[reset_login_button]</a>
					</p>

					<div class="fill">
						<div class="fill-h">Other ways forward</div>
						<div class="alt">
							<a href="/contact">
								<em><i class="far fa-comments" aria-hidden="true"></i></em>
								<div><b>No longer have that email?</b><small>Contact support for account assistance</small></div>
								<i class="fas fa-arrow-right go" aria-hidden="true"></i>
							</a>
							<a href="/signup">
								<em><i class="fas fa-user-plus" aria-hidden="true"></i></em>
								<div><b>Never had an account?</b><small>Create a new account from the signup page</small></div>
								<i class="fas fa-arrow-right go" aria-hidden="true"></i>
							</a>
						</div>

						<div class="badges">
							<div><i class="fas fa-lock" aria-hidden="true"></i><div><b>SSL Secured</b><small>Encrypted request</small></div></div>
							<div><i class="fas fa-fingerprint" aria-hidden="true"></i><div><b>Private</b><small>Protected recovery</small></div></div>
							<div><i class="fas fa-headset" aria-hidden="true"></i><div><b>Support</b><small>Help when needed</small></div></div>
						</div>
					</div>
				</div>

				<div class="card side rv">
					<div class="ch">
						<div class="ch-top">
							<em><i class="fas fa-route" aria-hidden="true"></i></em>
							<h2>What Happens Next</h2>
						</div>
						<small>A simple, secure recovery process</small>
					</div>

					<p>There is nothing to install. Submit the email associated with your account and follow the instructions you receive.</p>

					<ul class="tl">
						<li><em><i class="fas fa-paper-plane" aria-hidden="true"></i></em><b>Submit your email</b><p>Use the same email address that was entered when your account was created.</p></li>
						<li><em><i class="far fa-envelope-open" aria-hidden="true"></i></em><b>Check your inbox</b><p>Open the recovery message and follow the secure instructions provided there.</p></li>
						<li><em><i class="fas fa-shield-alt" aria-hidden="true"></i></em><b>Return securely</b><p>After completing recovery, use the normal sign-in page to access your account.</p></li>
					</ul>

					<div class="note"><i class="fas fa-info-circle" aria-hidden="true"></i><div><b>Keep recovery links private.</b> Never forward account recovery emails or share them with anyone.</div></div>
					<a href="/contact" class="help"><i class="far fa-comments" aria-hidden="true"></i> Still locked out? Contact support</a>
				</div>
			</div>
		</div>
	</section>

	<section class="qa" aria-labelledby="recovery-questions-title">
		<div class="wrp">
			<div class="qa-h rv">
				<span><i class="fas fa-life-ring" aria-hidden="true"></i> Good To Know</span>
				<h2 id="recovery-questions-title">Recovery, <em>Answered</em></h2>
			</div>

			<div class="qa-g">
				<article class="qa-c rv"><div class="qa-head"><em><i class="far fa-envelope-open" aria-hidden="true"></i></em><b>The email has not arrived</b></div><p>Check your spam and promotions folders, then confirm that you entered the exact address connected to the account.</p></article>
				<article class="qa-c rv"><div class="qa-head"><em><i class="far fa-clock" aria-hidden="true"></i></em><b>The recovery link expired</b></div><p>Return to this page and request another recovery message using the email associated with your account.</p></article>
				<article class="qa-c rv"><div class="qa-head"><em><i class="fas fa-user-shield" aria-hidden="true"></i></em><b>Keep your account protected</b></div><p>Use a unique password and never share passwords, recovery links or verification information with another person.</p></article>
			</div>
		</div>
	</section>
</main>

<script>
	(function () {
		'use strict';

		var page = document.getElementById('rzPage');
		if (!page) {
			return;
		}

		var root = document.documentElement;
		var body = document.body;

		function activeTheme() {
			var saved = null;
			try {
				saved = localStorage.getItem('lightMode');
			} catch (error) {}
			if (saved === 'dark' || saved === 'light') {
				return saved;
			}
			return root.classList.contains('light') || root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
		}

		function paintTheme() {
			var dark = activeTheme() === 'dark';
			root.setAttribute('data-rzdm', dark ? '1' : '0');
			body.classList.toggle('wr-dark', dark);
			body.classList.toggle('wr-light', !dark);
		}

		paintTheme();
		try {
			new MutationObserver(paintTheme).observe(root, {
				attributes: true,
				attributeFilter: ['class', 'data-bs-theme', 'data-theme']
			});
		} catch (error) {}

		var background = document.getElementById('rzBgFull');
		if (background && background.parentNode !== body) {
			body.insertBefore(background, body.firstChild);
		}

		var revealItems = page.querySelectorAll('.rv');
		if (!('IntersectionObserver' in window)) {
			for (var fallbackIndex = 0; fallbackIndex < revealItems.length; fallbackIndex += 1) {
				revealItems.item(fallbackIndex).classList.add('on');
			}
		} else {
			var revealObserver = new IntersectionObserver(function (entries) {
				entries.forEach(function (entry) {
					if (entry.isIntersecting) {
						entry.target.classList.add('on');
						revealObserver.unobserve(entry.target);
					}
				});
			}, { threshold: 0.06 });

			for (var revealIndex = 0; revealIndex < revealItems.length; revealIndex += 1) {
				revealItems.item(revealIndex).style.transitionDelay = (revealIndex % 3) * 90 + 'ms';
				revealObserver.observe(revealItems.item(revealIndex));
			}
		}

		page.addEventListener('click', function (event) {
			var close = event.target.closest ? event.target.closest('.alert .close') : null;
			if (close && close.parentElement) {
				close.parentElement.style.display = 'none';
			}
		});
	})();
</script>
