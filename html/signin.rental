</style>

<main class="login-clone" id="login-page">
	<section class="login-hero" aria-labelledby="login-hero-title">
		<div class="login-grid-pattern" aria-hidden="true"></div>
		<div class="login-hero-frame" aria-hidden="true">
			<span class="corner-1"></span>
			<span class="corner-2"></span>
			<span class="corner-3"></span>
			<span class="corner-4"></span>
		</div>

		<div class="login-container login-hero-grid">
			<div class="login-hero-copy reveal-item">
				<div class="login-trust-pill">
					<span class="login-trust-avatars" aria-hidden="true">
						<span>R</span><span>S</span><span>M</span><span>A</span>
					</span>
					<span>Built for resellers, agencies &amp; creators</span>
				</div>

				<div class="login-rating" aria-label="Excellent service rating">
					<span class="stars" aria-hidden="true">
						<i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
					</span>
					<span>Fast, secure and always available</span>
				</div>

				<h1 class="login-hero-title" id="login-hero-title">Conquer Every<br>Social <em>Platform</em></h1>
				<p class="login-hero-description">[panel.title] gives resellers, marketers and businesses a fast way to manage social media growth from one powerful dashboard.</p>
				<div class="login-hero-custom">[user_contact_us]</div>

				<div class="login-checks">
					<span><i class="fas fa-check-circle" aria-hidden="true"></i> Instant processing</span>
					<span><i class="fas fa-check-circle" aria-hidden="true"></i> Secure payments</span>
					<span><i class="fas fa-check-circle" aria-hidden="true"></i> Reliable support</span>
				</div>

				<div class="login-hero-actions">
					<a href="signup" class="login-hero-button primary"><i class="fas fa-rocket" aria-hidden="true"></i> [login.form.signup_button]</a>
					<a href="services" class="login-hero-button secondary"><i class="fas fa-list-ul" aria-hidden="true"></i> View services</a>
				</div>

				<div class="login-trust-grid">
					<div class="login-trust-item"><span class="login-trust-icon"><i class="fas fa-bolt"></i></span><div><b>Instant Start</b><small>Automated orders</small></div></div>
					<div class="login-trust-item"><span class="login-trust-icon"><i class="fas fa-gem"></i></span><div><b>Premium Quality</b><small>Multiple service tiers</small></div></div>
					<div class="login-trust-item"><span class="login-trust-icon"><i class="fas fa-headset"></i></span><div><b>Active Support</b><small>Help when needed</small></div></div>
					<div class="login-trust-item"><span class="login-trust-icon"><i class="fas fa-shield-alt"></i></span><div><b>Protected</b><small>Secure account access</small></div></div>
				</div>
			</div>

			<div class="login-card-wrap reveal-item">
				<div class="login-floating-card one" aria-hidden="true">
					<i class="fas fa-layer-group"></i>
					<div><b>All-in-one</b><small>Social media services</small></div>
				</div>
				<div class="login-floating-card two" aria-hidden="true">
					<i class="fas fa-headset"></i>
					<div><b>Always ready</b><small>Dedicated assistance</small></div>
				</div>

				<div class="login-card" id="home-login">
					<div class="login-card-head">
						<span class="login-card-mark"><i class="fas fa-shield-alt" aria-hidden="true"></i></span>
						<div>
							<h2>[login.form.header]</h2>
							<small>Sign in and command your growth</small>
						</div>
						<span class="login-live"><i></i> LIVE</span>
					</div>

					<form method="post" action="" id="rental-login-form">
						[error_message]
						[login.form.csrf_protection]

						<div class="login-field">
							<label for="username">[login.form.username]</label>
							<i class="fas fa-user login-field-icon" aria-hidden="true"></i>
							<input name="username" class="form-control" id="username" type="text" placeholder="[login.form.username]" autocomplete="username">
							<p class="help-block help-block-error login-help-block"></p>
						</div>

						<div class="login-field">
							<label for="password">[login.form.password]</label>
							<i class="fas fa-lock login-field-icon" aria-hidden="true"></i>
							<input name="password" class="form-control" id="password" type="password" placeholder="[login.form.password]" autocomplete="current-password">
							<button type="button" class="login-password-toggle" aria-label="Show password" aria-pressed="false">
								<i class="far fa-eye" aria-hidden="true"></i>
							</button>
							<p class="help-block help-block-error login-help-block"></p>
						</div>

						<div class="login-options">
							<label class="login-remember" for="remembered">
								<input name="remember_me" id="remembered" value="1" type="checkbox">
								<span>[login.form.remember_me_text]</span>
							</label>
							<a href="reset-password" class="login-forgot">[login.form.reset_password_button]</a>
						</div>

						<button type="submit" name="login_btn" class="btn btn-primary login-submit">
							<i class="fas fa-sign-in-alt" aria-hidden="true"></i>
							<span>[login.form.submit_button]</span>
						</button>

						<div class="login-wrong-entry">[login.form.wrong_enter]</div>
					</form>

					<div class="login-divider">New to the panel?</div>
					<p class="login-signup-row">
						<span>[login.form.signup_text]</span>
						<a href="signup" class="btn btn-primary">[login.form.signup_button]</a>
					</p>

					<div class="login-card-foot">
						<div><i class="fas fa-lock" aria-hidden="true"></i><b>SSL Secured</b><small>Encrypted login</small></div>
						<div><i class="fas fa-user-shield" aria-hidden="true"></i><b>Protected</b><small>Safe account</small></div>
						<div><i class="fas fa-bolt" aria-hidden="true"></i><b>Fast Access</b><small>Instant dashboard</small></div>
					</div>
				</div>

				<div class="login-referral">[login.form.allow_refferal]</div>
			</div>
		</div>
	</section>

	<section class="login-platforms" aria-label="Supported social platforms">
