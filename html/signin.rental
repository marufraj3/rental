				</div>
			</div>
		</div>
	</section>
</main>

[content_footer]

<script>
	(function () {
		'use strict';

		var page = document.getElementById('login-page');
		if (!page) {
			return;
		}

		page.classList.add('reveal-ready');

		var passwordInput = page.querySelector('#password');
		var passwordToggle = page.querySelector('.login-password-toggle');

		if (passwordInput && passwordToggle) {
			passwordToggle.addEventListener('click', function () {
				var showing = passwordInput.type === 'text';
				var icon = passwordToggle.querySelector('i');
				passwordInput.type = showing ? 'password' : 'text';
				passwordToggle.setAttribute('aria-pressed', showing ? 'false' : 'true');
				passwordToggle.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
				if (icon) {
					icon.className = showing ? 'far fa-eye' : 'far fa-eye-slash';
				}
				passwordInput.focus();
			});
		}

		var slots = page.querySelectorAll('[data-dynamic-slot]');
		for (var slotIndex = 0; slotIndex < slots.length; slotIndex += 1) {
			var slot = slots.item(slotIndex);
			var inner = slot.querySelector('.login-dynamic-inner');
			if (inner && !inner.textContent.trim() && !inner.children.length) {
				slot.classList.add('is-empty');
			}
		}

		var revealItems = page.querySelectorAll('.reveal-item');
		if (!('IntersectionObserver' in window)) {
			for (var itemIndex = 0; itemIndex < revealItems.length; itemIndex += 1) {
				revealItems.item(itemIndex).classList.add('is-visible');
			}
			return;
		}

		var observer = new IntersectionObserver(function (entries) {
			entries.forEach(function (entry) {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			});
		}, { threshold: 0.10, rootMargin: '0px 0px -28px' });

		for (var revealIndex = 0; revealIndex < revealItems.length; revealIndex += 1) {
			observer.observe(revealItems.item(revealIndex));
		}
	})();
</script>
