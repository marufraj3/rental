		
			<div class="paddingbody"></div>
			<div class="container-fluid container-fluid-spacious">
				<div class="row">
					<div class="col-md-12">
						<div  class="well">
							[addfunds.content.top]
						</div>	
						<div class="row">
							<div class="col-md-12">
								<nav>
									<ul class="nav nav-pills " id="pills-tab" role="tablist">
										<li class="nav-item active">
											<a class="nav-link active" id="pills-home-tab" data-toggle="pill" href="#new-order" role="tab" aria-controls="pills-home" aria-selected="true">[add_funds.tab.add]</a>
										</li>
										<li class="nav-item">
											<a class="nav-link" id="pills-home-tab" data-toggle="pill" href="#check-updates" role="tab" aria-controls="pills-home" aria-selected="true">[add_funds.tab.updates]</a>
										</li>
										
									</ul>
									<select name="page_Category" id="page_Category" class="custom-select w-full">
										<option value="0">[add_funds.tab.add]</option>
										<option value="1">[add_funds.tab.updates]</option>
									</select>
								</nav>
							</div>	
							<div class="col-md-12">
								<!-- Tab Conetent Starts here -->
								<div class="tab-content" id="pills-tabContent">
									<!-- New Order Tab -->
									<div class="tab-pane fade active in" id="new-order" role="tabpanel" aria-labelledby="pills-home-tab">
										<div id="main-page" class="well well-float table-responsive">
											[error_message]
											<form  method="post" action="" data-parsley-validate="" id="demo-form2" novalidate="">
												<div class="form-group">
													<label class="control-label" for="payment_type"> [add_funds.form.method] </label>
													<select  name="payment_type" id="payment_type"  class="form-control" >
														[add_funds.form.method.list]	
													</select>
													<p class="help-block help-block-error"></p>
												</div>
												
												
													
													<div class="form-group row" id="image_areaa" style="display:none;" >
														<div class="col-md-12">
															<img src="" id="iiimaaageID" class="img-fluid" style="max-width:100%;" />
														</div>
													</div>
													
													
													<div class="form-group" id="instruction_div" style="display:none;"  >
														<label class="control-label" for="instructions"></label>
														<div class="panel-body border-solid border-rounded" id="instructions" ></div>
													</div>
													
													<div class="form-group" id="transaction_area" style="display:none;" >
														<label class="control-label" id="transaction_id_dvi" for="transaction_id"></label>
														<input class="form-control" name="transaction_id" id="transaction_id" type="text">
														<p class="help-block help-block-error"></p>
													</div>
													
													<div class="form-group">
														<label class="control-label" id="amount_id_dvi" for="amount"></label>
														<input class="form-control" name="amount" id="amount" required type="text">
														<p class="help-block help-block-error"></p>
													</div>
													
													<div class="form-group">
														<label><input type="checkbox" name="checkbox" > [add_funds.form.charge_back_text] </label>
													</div>
													
													[panel.csrf_protection]
													<button type="submit" class="btn btn-default"> [add_funds.form.pay_button] </button>
											</form>
										</div>
									</div>
									
										<!-- check-updates Tab -->
									<div class="tab-pane fade" id="check-updates" role="tabpanel" aria-labelledby="pills-contact-tab">
										<div id="main-page" class="well well-float table-responsive">
											[add_funds.content.bottom]
										</div>
									</div>
									
									<div id="main-page" class="well well-float table-responsive">
										<a class="btn btn-primary ticketbtn center" href="tickets">[pages_ticket_button]</a>
									</div>
								</div>
							</div>	
						</div>
					</div>
						<!-- End Tab Content -->	  
				</div>
			</div>
		
		
		
		
		