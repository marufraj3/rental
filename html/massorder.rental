	
	<div class="paddingbody"></div>
	<div class="container-fluid container-fluid-spacious">
		<div class="col-md-12">
			<div class="row">
				<div class="col-md-12">
					<nav>
						<ul class="nav nav-pills " id="pills-tab" role="tablist">
							<li class="nav-item active">
								<a class="nav-link active" id="pills-home-tab" data-toggle="pill" href="#new-order" role="tab" aria-controls="pills-home" aria-selected="true">[mass.tab.add_order]</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" id="pills-home-tab" data-toggle="pill" href="#check-updates" role="tab" aria-controls="pills-home" aria-selected="true">[mass.tab.check_update]</a>
							</li>
						</ul>
						<select name="page_Category" id="page_Category" class="custom-select w-full">
							<option value="0">[mass.tab.add_order]</option>
							<option value="1">[mass.tab.check_update]</option>
						</select>
					</nav>	  
				</div>
				<div class="col-md-12">
					<!-- Tab Conetent Starts here -->
					<div class="tab-content" id="pills-tabContent">
						<!-- New Order Tab -->
						<div class="tab-pane fade active in" id="new-order" role="tabpanel" aria-labelledby="pills-home-tab">
							<div id="main-page" class="well well-float table-responsive">
								[error_message]
								[mass.processing.result]
								<form method="post" action="">
									<div class="form-group">
									  <label>[mass.form.heading]</label>
									  <textarea id="message" name="orders" rows="15" class="form-control" placeholder="service_id | link | quantity"></textarea>
									  <input name="sender" value="1" type="hidden">
									</div>
										[panel.csrf_protection]
									 <input name="mass_order" value="mass_order" type="hidden">
									<button type="submit" class="btn btn-default">[mass.form.submit_button]</button>
								</form>
								
							</div>
						</div>
						<!-- All Orders Tab -->
						<div class="tab-pane fade" id="check-updates" role="tabpanel" aria-labelledby="pills-contact-tab">
							<div id="main-page" class="well well-float table-responsive">
								[mass.content.mass_order_content]
							</div>
						</div>
					</div>
					<!-- End Tab Content  -->
				</div>
			</div>
		</div>
	</div>
	
	
	
	