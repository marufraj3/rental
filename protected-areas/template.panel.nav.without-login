<header class="mother-guest-header" id="mother-guest-header">
	<div class="container">
		<nav class="navbar navbar-default navbar-static-top main-header" aria-label="Primary navigation">
			<div class="mh-wrapper">
				<div class="navbar-header mh-logo">
					<a class="navbar-brand navbar-brand-emphasized" href="/" aria-label="[panel.title] home">
						[panel.panel_icon]
					</a>
				</div>

				<div class="mh-menu-btn">
					<button
						type="button"
						class="navbar-toggle collapsed mh-burger"
						data-toggle="collapse"
						data-target="#navbar"
						aria-expanded="false"
						aria-controls="navbar"
						aria-label="Toggle navigation"
					>
						<span class="sr-only">Toggle navigation</span>
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-linecap="round">
							<path stroke="currentColor" stroke-width="2.4" d="M4 7h16"></path>
							<path stroke="currentColor" stroke-width="2.4" d="M4 12h11"></path>
							<path stroke="currentColor" stroke-width="2.4" d="M4 17h16"></path>
						</svg>
					</button>
				</div>

				<div id="navbar" class="navbar-collapse collapse mh-menu-wrapper">
					<div class="mh-menu">
						<ul class="nav navbar-nav menu" id="guest-main-menu">
							[panel.main_nav_drop_down]
						</ul>

						<div class="mh-mtheme">
							<span>Theme</span>
							<button type="button" class="mother-theme-toggle mother-theme-mobile" aria-label="Toggle color theme">
								<span class="mother-theme-knob" aria-hidden="true"></span>
								<svg class="mother-theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
								<svg class="mother-theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4 7 7 0 0 0 20 14.5Z"></path></svg>
							</button>
						</div>
					</div>

					<div class="mh-utility">
						[panel.currency_nav_drop_down]
						[panel.language_nav_dropdown]
					</div>

					<button type="button" class="rental-theme-toggle mother-theme-toggle mother-theme-desktop" aria-label="Toggle color theme">
						<span class="mother-theme-knob" aria-hidden="true"></span>
						<svg class="mother-theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
						<svg class="mother-theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4 7 7 0 0 0 20 14.5Z"></path></svg>
					</button>

					<div class="mh-buttons" id="guest-action-buttons"></div>
				</div>
			</div>
		</nav>
	</div>
</header>

<script>
	(function () {
		'use strict';

		var header = document.getElementById('mother-guest-header');
		if (!header) {
			return;
		}

		var root = document.documentElement;
		var body = document.body;
		var menu = header.querySelector('#guest-main-menu');
		var actions = header.querySelector('#guest-action-buttons');
		var utility = header.querySelector('.mh-utility');

		function normalizedLabel(link) {
			return (link.textContent || '').replace(/\s+/g, ' ').trim();
		}

		function createAction(source, type) {
			var action = source.cloneNode(false);
			var label = normalizedLabel(source);
			action.removeAttribute('id');
			action.className = type === 'signup' ? 'btn btn-primary mother-signup-button' : 'btn btn-light mother-signin-button';
			action.textContent = '';

			if (type === 'signup') {
				var icon = document.createElement('span');
				icon.className = 'btn-icon';
				icon.setAttribute('aria-hidden', 'true');
				icon.innerHTML = '<i class="far fa-user-circle"></i>';
				action.appendChild(icon);
			}

			var text = document.createElement('span');
			text.className = 'btn-label';
			text.textContent = label;
			action.appendChild(text);
			return action;
		}

		if (menu && actions) {
			var links = menu.querySelectorAll(':scope > li > a');
			var signInSource = null;
			var signUpSource = null;

			for (var linkIndex = 0; linkIndex < links.length; linkIndex += 1) {
				var link = links.item(linkIndex);
				var item = link.parentElement;
				var href = (link.getAttribute('href') || '').toLowerCase().replace(/\/$/, '');
				var label = normalizedLabel(link).toLowerCase();
				var isSignUp = href.indexOf('signup') !== -1 || href.indexOf('register') !== -1 || label.indexOf('sign up') !== -1 || label.indexOf('register') !== -1;
				var isSignIn = href === '' || href === '/login' || href === '/signin' || label.indexOf('sign in') !== -1 || label === 'login';

				if (isSignUp && !signUpSource) {
					signUpSource = link;
					item.classList.add('rental-signup-link', 'mother-action-source');
				} else if (isSignIn && !signInSource) {
					signInSource = link;
					item.classList.add('rental-login-link');
				}
			}

			if (signInSource) {
				actions.appendChild(createAction(signInSource, 'signin'));
			}
			if (signUpSource) {
				actions.appendChild(createAction(signUpSource, 'signup'));
			}
			if (!actions.children.length) {
				actions.classList.add('is-empty');
			}
		}

		if (utility && !utility.children.length && !utility.textContent.trim()) {
			utility.classList.add('is-empty');
		}

		function currentTheme() {
			return root.classList.contains('dark') || root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
		}

		function applyTheme(theme) {
			root.classList.remove('light', 'dark');
			root.classList.add(theme);
			root.setAttribute('data-theme', theme);
			body.classList.remove('light', 'dark');
			body.classList.add(theme);

			try {
				localStorage.setItem('lightMode', theme);
			} catch (error) {}

			var themeMeta = document.querySelector('meta[name="theme-color"]');
			if (themeMeta) {
				themeMeta.setAttribute('content', theme === 'dark' ? '#0e0609' : '#fff6f7');
			}

			var themeButtons = header.querySelectorAll('.mother-theme-toggle');
			for (var themeIndex = 0; themeIndex < themeButtons.length; themeIndex += 1) {
				var themeButton = themeButtons.item(themeIndex);
				themeButton.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
				themeButton.setAttribute('title', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
			}
		}

		var toggles = header.querySelectorAll('.mother-theme-toggle');
		for (var toggleIndex = 0; toggleIndex < toggles.length; toggleIndex += 1) {
			toggles.item(toggleIndex).addEventListener('click', function () {
				applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
			});
		}

		applyTheme(currentTheme());
	})();
</script>
