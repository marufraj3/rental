<header id="mother-guest-header">
	<div class="container">
		<div class="main-header">
			<div class="mh-wrapper">
				<div class="mh-logo">
					<a href="/" aria-label="[panel.title] home">
						[panel.panel_icon]
					</a>
				</div>

				<div class="mh-menu-btn">
					<button type="button" class="btn btn-light btn-icon mh-burger" aria-label="Menu" aria-expanded="false" aria-controls="guest-navbar">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke-linecap="round" aria-hidden="true">
							<path stroke="currentColor" stroke-width="2.4" d="M4 7h16"></path>
							<path stroke="currentColor" stroke-width="2.4" d="M4 12h11"></path>
							<path stroke="currentColor" stroke-width="2.4" d="M4 17h16"></path>
						</svg>
					</button>
				</div>

				<div class="mh-menu-wrapper" id="guest-navbar" aria-hidden="false">
					<div class="mh-menu">
						<ul class="menu" id="guest-main-menu">
							[panel.main_nav_drop_down]
						</ul>

						<div class="mh-mtheme">
							<span>Theme</span>
							<button type="button" class="wtog wtog-mob" aria-label="Toggle theme" aria-pressed="false">
								<span class="wtog-k" aria-hidden="true"></span>
								<svg class="wtog-s" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
								<svg class="wtog-m" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path></svg>
							</button>
						</div>
					</div>

					<div class="mh-buttons">
						<button type="button" class="wtog wtog-desk" aria-label="Toggle theme" aria-pressed="false">
							<span class="wtog-k" aria-hidden="true"></span>
							<svg class="wtog-s" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
							<svg class="wtog-m" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path></svg>
						</button>

						<span id="guest-action-anchor" aria-hidden="true"></span>

						<div class="mh-utility">
							[panel.currency_nav_drop_down]
							[panel.language_nav_dropdown]
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</header>
